{
  "schema_version": "2.0.0",
  "service": "hhm-api",
  "title": "Hacker House Medellín API surface",
  "version": "0.1.0",
  "description": "Combined HTTP contract for the reservation/visitor API and the versioned intake API. Newly shared intake and visitor payloads remain explicitly opaque Json here until their hhm-interfaces definitions are projected into RIDL; route methods, path parameters, and body presence are still checked against Rust handlers.",
  "types": {
    "ReservationId": {
      "kind": "scalar",
      "base": "Uuid",
      "doc": "Server-minted id for one reservation."
    },
    "ReservationStatus": {
      "kind": "enum",
      "variants": ["pending", "confirmed", "checked_in", "checked_out", "cancelled"]
    },
    "Reservation": {
      "kind": "record",
      "fields": {
        "id": "ReservationId",
        "created_at": "DateTime",
        "updated_at": "DateTime",
        "member_name": "String",
        "room_type": "String",
        "check_in": "DateTime",
        "check_out": "DateTime",
        "workspace_plan": "String",
        "status": "ReservationStatus",
        "notes": "String"
      }
    },
    "CreateReservation": {
      "kind": "record",
      "fields": {
        "member_name": "String",
        "room_type": "String",
        "check_in": "DateTime",
        "check_out": "DateTime",
        "workspace_plan": "String",
        "status": "ReservationStatus",
        "notes": "String"
      }
    },
    "ReservationEvent": {
      "kind": "record",
      "fields": {
        "event": "String",
        "reservation": "Reservation"
      }
    },
    "Health": {
      "kind": "record",
      "fields": {
        "service": "String",
        "status": "String"
      }
    },
    "ApiError": {
      "kind": "record",
      "fields": {
        "code": "String",
        "message": "String"
      }
    }
  },
  "map": {
    "healthz": {
      "path": "/healthz",
      "methods": ["GET"],
      "summary": "Liveness and bounded service configuration state.",
      "response": "Json"
    },
    "readyz": {
      "path": "/readyz",
      "methods": ["GET"],
      "summary": "Readiness probe for the intake service and its required persistence backends.",
      "response": "Json"
    },
    "list_reservations": {
      "path": "/v1/reservations",
      "methods": ["GET"],
      "summary": "List demo reservations.",
      "response": {"kind": "list", "item": "Reservation"}
    },
    "create_reservation": {
      "path": "/v1/reservations",
      "methods": ["POST"],
      "summary": "Create a demo reservation.",
      "request": "CreateReservation",
      "response": "Reservation"
    },
    "get_reservation": {
      "path": "/v1/reservations/{id}",
      "methods": ["GET"],
      "summary": "Get one demo reservation.",
      "path_params": {"id": "ReservationId"},
      "response": "Reservation"
    },
    "create_pre_interest": {
      "path": "/v1/pre-interests",
      "methods": ["POST"],
      "summary": "Submit the public pre-interest intake contract.",
      "request": "Json",
      "response": "Json"
    },
    "create_upload_intent": {
      "path": "/v1/intake/uploads",
      "methods": ["POST"],
      "summary": "Create a bounded intake upload intent and signed upload URL.",
      "request": "Json",
      "response": "Json"
    },
    "complete_upload": {
      "path": "/v1/intake/uploads/{upload_id}/complete",
      "methods": ["POST"],
      "summary": "Verify and complete a previously created intake upload.",
      "path_params": {"upload_id": "Uuid"},
      "request": "Json",
      "response": "Json"
    },
    "create_application": {
      "path": "/v1/applications",
      "methods": ["POST"],
      "summary": "Submit the full residency/application intake contract.",
      "request": "Json",
      "response": "Json"
    },
    "create_referral": {
      "path": "/v1/referrals",
      "methods": ["POST"],
      "summary": "Submit an authenticated referral.",
      "request": "Json",
      "response": "Json"
    },
    "issue_visitor_qr": {
      "path": "/v1/visitor-qr/{action}",
      "methods": ["POST"],
      "summary": "Issue an authenticated visitor check-in or check-out QR code.",
      "path_params": {"action": "String"},
      "request": "Json",
      "response": "Json"
    },
    "visitor_check_in": {
      "path": "/v1/visits/check-in",
      "methods": ["POST"],
      "summary": "Redeem a visitor check-in QR and create an active visit.",
      "request": "Json",
      "response": "Json"
    },
    "visitor_check_out": {
      "path": "/v1/visits/check-out",
      "methods": ["POST"],
      "summary": "Redeem a visitor check-out QR and close an active visit.",
      "request": "Json",
      "response": "Json"
    },
    "reservation_events": {
      "path": "/v1/ws",
      "methods": ["GET"],
      "summary": "Websocket reservation event stream.",
      "client": false
    }
  }
}
